# Copy thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# ===== Django =====
DJANGO_SECRET_KEY=change-me
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
FRONTEND_URL=http://localhost:3000

# ===== Database =====
# Để trống -> dùng SQLite (db.sqlite3). Production nên dùng PostgreSQL:
# DATABASE_URL=postgresql://hrm_user:hrm_password@localhost:5432/hrm_db
DATABASE_URL=

# ===== Thông tin công ty (email, bản in, mật khẩu mặc định) =====
COMPANY_NAME=Công ty của bạn
COMPANY_LEGAL_NAME=
HR_DEPARTMENT_LABEL=Phòng Hành chính - Nhân sự
HR_CONTACT_ADDRESS=
HR_CONTACT_PHONE=
HRM_PORTAL_URL=
USER_GUIDE_URL=
EMAIL_LOGO_URL=
EMAIL_BANNER_URL=
DEFAULT_PASSWORD_PREFIX=hrm
EMPLOYEE_ID_FALLBACK_PREFIX=NV
EMPLOYEE_IMPORT_DEFAULT_PASSWORD=ChangeMe@2024

# ===== Email SMTP (Django send_mail) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# ===== Gửi email qua Gmail API (OAuth2) =====
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=

# ===== Lưu trữ file (S3 / Cloudfly — tuỳ chọn) =====
CLOUDFLY_ENABLED=False
CLOUDFLY_S3_ENDPOINT=https://s3.cloudfly.vn
CLOUDFLY_ACCESS_KEY=
CLOUDFLY_SECRET_KEY=
CLOUDFLY_BUCKET=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=
AWS_CLOUDFRONT_KEY_ID=
AWS_CLOUDFRONT_PRIVATE_KEY_PATH=

# ===== Push notification (OneSignal — tuỳ chọn) =====
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ===== Tích hợp khác (tuỳ chọn) =====
# Key cho app chấm công mobile gọi vào API (header X-Server-Key). Để trống = tắt.
SERVER_API_KEY=
CRM_API_BASE_URL=
CRM_API_KEY=
CRM_DEBUG_MODE=True
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=
EMPLOYEE_MASTER_SHEET_ID=
EMPLOYEE_MASTER_SHEET_RANGE=A1:ZZ
REDIS_URL=redis://localhost:6379/0
