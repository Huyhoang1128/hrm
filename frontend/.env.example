# Copy thành .env.local rồi sửa theo môi trường của bạn.

# Backend Django (không có dấu / ở cuối)
VITE_API_BASE_URL=http://localhost:8000
# Dùng cho ảnh/media và proxy /api/v1 khi chạy `npm run dev`
VITE_MANAGEMENT_API_URL=http://localhost:8000

# Thương hiệu
VITE_APP_NAME=HRM
VITE_COMPANY_NAME=Công ty của bạn
VITE_COMPANY_LEGAL_NAME=CÔNG TY CỦA BẠN
VITE_HR_DEPARTMENT_LABEL=Phòng Hành chính - Nhân sự
VITE_SUPPORT_EMAIL=
VITE_LOGO_URL=/logo.svg
# Phải khớp DEFAULT_PASSWORD_PREFIX ở backend
VITE_DEFAULT_PASSWORD_PREFIX=hrm

# App chấm công bên ngoài (tuỳ chọn) — để trống nếu không dùng
VITE_CHECKIN_APP_API_URL=
VITE_CHECKIN_APP_API_KEY=
